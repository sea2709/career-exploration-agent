# Gemini API key — required for the career explorer agent
# Create at: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.8-flash

# Sanity (Careers Exploration — rhq335ze / production)
# SANITY_PROJECT_ID=rhq335ze
# SANITY_DATASET=production

# Viewer token for Sanity Context MCP (required for the agent)
# npx sanity tokens add "Sanity Context" --role=viewer --yes --json --project-id=rhq335ze
SANITY_API_TOKEN=

# Optional: endpoint URL from the Context app (Sanity Dashboard → Context → MCP endpoint).
# Org endpoints need SANITY_API_TOKEN to be an organization token with Context access.
# Default (legacy, dataset-addressed): https://api.sanity.io/v2026-03-03/context/mcp/rhq335ze/production
# SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v2026-09-01/context/organizations/opj96zyhx/mcp/<endpoint-name>

# Optional: interview coaching Knowledge Base for the Mock Interview Coach (skipped if unset).
# Create an MCP endpoint in the Context app with Content source = Knowledge base, pick
# "Interview coaching guidance", and paste its URL here. See README "Coaching Knowledge Base".
# SANITY_COACHING_MCP_URL=https://api.sanity.io/v2026-09-01/context/organizations/opj96zyhx/mcp/interview-coaching
# Organization token with Context access. Falls back to SANITY_API_TOKEN when unset.
# SANITY_COACHING_TOKEN=

# Conversation Insights — saves chat transcripts to the org's Context store (skipped if unset)
# Editor token: npx sanity tokens add "Sanity Context Insights" --role=editor --yes --json --project-id=rhq335ze
SANITY_ORGANIZATION_ID=opj96zyhx
# Slug of the Sanity Context document; groups conversations in the Insights dashboard
SANITY_CONTEXT_ENDPOINT_NAME=career-explorer
SANITY_INSIGHTS_TOKEN=

# HTTP server
# PORT=8787
# Required. Callers send it as `Authorization: Bearer <token>` on POST /chat.
# Generate with: openssl rand -base64 32
AGENT_API_TOKEN=
# Comma-separated browser origins allowed to call POST /chat (the web app's URL)
# ALLOWED_ORIGINS=http://localhost:4321
